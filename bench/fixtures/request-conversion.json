[
  {
    "name": "simple text",
    "input": {
      "model": "gpt-4",
      "max_tokens": 100,
      "messages": [{ "role": "user", "content": "Hello" }]
    },
    "expected": {
      "model": "gpt-4",
      "messages": [{ "role": "user", "content": "Hello" }],
      "stream": false,
      "max_tokens": 100
    }
  },
  {
    "name": "billing header and streaming usage",
    "input": {
      "model": "gpt-4",
      "max_tokens": 64,
      "stream": true,
      "system": "x-anthropic-billing-header: ignored\nKeep this",
      "messages": [{ "role": "user", "content": "Hello" }]
    },
    "expected": {
      "model": "gpt-4",
      "messages": [
        { "role": "system", "content": "Keep this" },
        { "role": "user", "content": "Hello" }
      ],
      "max_tokens": 64,
      "stream": true,
      "stream_options": { "include_usage": true }
    }
  },
  {
    "name": "mid-conversation system message",
    "input": {
      "model": "gpt-5.2",
      "max_tokens": 100,
      "messages": [
        { "role": "user", "content": "Inspect the repository." },
        {
          "role": "system",
          "content": [{ "type": "text", "text": "Keep the next response concise." }]
        }
      ]
    },
    "expected": {
      "model": "gpt-5.2",
      "messages": [
        { "role": "user", "content": "Inspect the repository." },
        { "role": "assistant", "content": "Keep the next response concise." }
      ],
      "stream": false,
      "max_completion_tokens": 100
    }
  },
  {
    "name": "tool call and result",
    "input": {
      "model": "gpt-4",
      "max_tokens": 100,
      "messages": [
        {
          "role": "assistant",
          "content": [
            {
              "type": "tool_use",
              "id": "toolu_123",
              "name": "weather",
              "input": { "city": "Paris" }
            }
          ]
        },
        {
          "role": "user",
          "content": [{ "type": "tool_result", "tool_use_id": "toolu_123", "content": "Sunny" }]
        }
      ]
    },
    "expected": {
      "model": "gpt-4",
      "messages": [
        {
          "role": "assistant",
          "content": null,
          "tool_calls": [
            {
              "id": "toolu_123",
              "type": "function",
              "function": { "name": "weather", "arguments": "{\"city\":\"Paris\"}" }
            }
          ]
        },
        { "role": "tool", "tool_call_id": "toolu_123", "content": "Sunny" }
      ],
      "stream": false,
      "max_tokens": 100
    }
  },
  {
    "name": "explicit reasoning effort",
    "input": {
      "model": "gpt-5.2",
      "max_tokens": 100,
      "output_config": { "effort": "max" },
      "messages": [{ "role": "user", "content": "Think" }]
    },
    "expected": {
      "model": "gpt-5.2",
      "messages": [{ "role": "user", "content": "Think" }],
      "stream": false,
      "max_completion_tokens": 100,
      "reasoning_effort": "xhigh"
    }
  },
  {
    "name": "empty tools omitted",
    "input": {
      "model": "gpt-4",
      "max_tokens": 100,
      "tools": [],
      "messages": [{ "role": "user", "content": "Hello" }]
    },
    "expected": {
      "model": "gpt-4",
      "messages": [{ "role": "user", "content": "Hello" }],
      "stream": false,
      "max_tokens": 100
    }
  },
  {
    "name": "contentless hook messages omitted",
    "input": {
      "model": "gpt-4",
      "max_tokens": 10,
      "messages": [
        { "role": "user" },
        { "role": "assistant", "content": null },
        { "role": "user", "content": "Continue" }
      ]
    },
    "expected": {
      "model": "gpt-4",
      "messages": [{ "role": "user", "content": "Continue" }],
      "stream": false,
      "max_tokens": 10
    }
  },
  {
    "name": "tool choice none",
    "input": {
      "model": "gpt-4",
      "max_tokens": 10,
      "messages": [{ "role": "user", "content": "Hello" }],
      "tool_choice": { "type": "none" }
    },
    "expected": {
      "model": "gpt-4",
      "messages": [{ "role": "user", "content": "Hello" }],
      "stream": false,
      "max_tokens": 10,
      "tool_choice": "auto"
    }
  },
  {
    "name": "tool choice auto",
    "input": {
      "model": "gpt-4",
      "max_tokens": 10,
      "messages": [{ "role": "user", "content": "Hello" }],
      "tool_choice": { "type": "auto" }
    },
    "expected": {
      "model": "gpt-4",
      "messages": [{ "role": "user", "content": "Hello" }],
      "stream": false,
      "max_tokens": 10,
      "tool_choice": "auto"
    }
  },
  {
    "name": "tool choice any",
    "input": {
      "model": "gpt-4",
      "max_tokens": 10,
      "messages": [{ "role": "user", "content": "Hello" }],
      "tools": [{ "name": "lookup", "input_schema": { "type": "object" } }],
      "tool_choice": { "type": "any", "disable_parallel_tool_use": true }
    },
    "expected": {
      "model": "gpt-4",
      "messages": [{ "role": "user", "content": "Hello" }],
      "stream": false,
      "max_tokens": 10,
      "tools": [
        {
          "type": "function",
          "function": { "name": "lookup", "parameters": { "type": "object" } }
        }
      ],
      "tool_choice": "required"
    }
  },
  {
    "name": "named strict custom tool",
    "input": {
      "model": "gpt-4",
      "max_tokens": 10,
      "messages": [
        { "role": "user", "content": "Return JSON" },
        { "role": "assistant", "content": "{" }
      ],
      "tools": [
        {
          "type": "custom",
          "name": "lookup",
          "description": "Lookup a value",
          "input_schema": { "type": "object" },
          "strict": true,
          "cache_control": { "type": "ephemeral" }
        }
      ],
      "tool_choice": { "type": "tool", "name": "lookup" }
    },
    "expected": {
      "model": "gpt-4",
      "messages": [
        { "role": "user", "content": "Return JSON" },
        { "role": "assistant", "content": "{" }
      ],
      "stream": false,
      "max_tokens": 10,
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "lookup",
            "description": "Lookup a value",
            "parameters": { "type": "object" }
          }
        }
      ],
      "tool_choice": { "type": "function", "function": { "name": "lookup" } }
    }
  },
  {
    "name": "glm first chat uses TS-compatible core fields",
    "input": {
      "model": "glm-5.2",
      "max_tokens": 128,
      "stream": true,
      "thinking": { "type": "adaptive" },
      "output_config": {
        "effort": "high",
        "format": { "type": "json_schema", "schema": { "type": "object" } }
      },
      "messages": [{ "role": "user", "content": "Hello" }],
      "tools": [
        {
          "name": "lookup",
          "input_schema": { "type": "object" },
          "strict": true
        }
      ],
      "tool_choice": { "type": "auto", "disable_parallel_tool_use": true }
    },
    "expected": {
      "model": "glm-5.2",
      "messages": [{ "role": "user", "content": "Hello" }],
      "stream": true,
      "max_tokens": 128,
      "stream_options": { "include_usage": true },
      "tools": [
        {
          "type": "function",
          "function": { "name": "lookup", "parameters": { "type": "object" } }
        }
      ],
      "tool_choice": "auto",
      "thinking": { "type": "enabled" },
      "tool_stream": true,
      "reasoning_effort": "high"
    }
  },
  {
    "name": "unknown fields and roles follow TypeScript mapping",
    "input": {
      "model": "gpt-4",
      "max_tokens": 10,
      "stream": false,
      "system": "base",
      "top_k": 40,
      "messages": [
        { "role": "user", "content": "hello", "unknown": true },
        { "role": "system", "content": "mid-turn instruction" },
        { "role": "hook", "content": "hook text" },
        { "role": "user", "content": [{ "type": "search_result", "content": [] }] }
      ],
      "stop_sequences": [],
      "tool_choice": { "type": "none" },
      "output_config": {
        "format": { "type": "json_schema", "schema": { "type": "object" } }
      }
    },
    "expected": {
      "model": "gpt-4",
      "messages": [
        { "role": "system", "content": "base" },
        { "role": "user", "content": "hello" },
        { "role": "assistant", "content": "mid-turn instruction" },
        { "role": "assistant", "content": "hook text" }
      ],
      "stream": false,
      "max_tokens": 10,
      "stop": [],
      "tool_choice": "auto"
    }
  },
  {
    "name": "tool result fallback and thinking history follow TypeScript mapping",
    "input": {
      "model": "gpt-4",
      "max_tokens": 10,
      "messages": [
        {
          "role": "assistant",
          "content": [{ "type": "thinking", "thinking": "private", "signature": "sig" }]
        },
        {
          "role": "user",
          "content": [
            {
              "type": "tool_result",
              "tool_use_id": "unmatched",
              "content": [
                { "type": "text", "text": "one" },
                { "type": "search_result", "content": [] },
                { "type": "text", "text": "two" }
              ],
              "is_error": true
            },
            { "type": "text", "text": "continue" }
          ]
        }
      ]
    },
    "expected": {
      "model": "gpt-4",
      "messages": [
        { "role": "assistant", "content": null },
        { "role": "tool", "tool_call_id": "unmatched", "content": "Error: one\ntwo" },
        { "role": "user", "content": "continue" }
      ],
      "stream": false,
      "max_tokens": 10
    }
  }
]
