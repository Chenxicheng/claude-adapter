{
  "name": "claude-adapter",
  "version": "2.0.0",
  "description": "Proxy to convert Anthropic API requests to OpenAI format for Claude Code",
  "bin": {
    "claude-adapter": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:native": "cargo build --manifest-path native/Cargo.toml --release",
    "build:release": "npm run build && npm run obfuscate:dist",
    "start": "node dist/cli.js",
    "dev": "npx ts-node src/cli.ts",
    "test": "jest",
    "test:native": "cargo test --manifest-path native/Cargo.toml",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:native": "cargo fmt --manifest-path native/Cargo.toml --check && cargo clippy --manifest-path native/Cargo.toml --all-targets -- -D warnings",
    "obfuscate:dist": "node scripts/obfuscate-dist.mjs",
    "release:assets": "node scripts/build-release-assets.mjs",
    "prepublishOnly": "npm test -- --runInBand && npm run test:native && npm run lint && npm run lint:native && npm run build:release"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "keywords": [
    "claude",
    "claude-code-adapter",
    "openai-to-claude",
    "openai",
    "anthropic",
    "proxy",
    "claude-adapter",
    "api",
    "claude-code",
    "llm",
    "ai"
  ],
  "author": {
    "name": "Shanto Islam",
    "email": "shantoislamdev@gmail.com",
    "url": "https://shantoislamdev.web.app/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shantoislamdev/claude-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/shantoislamdev/claude-adapter/issues"
  },
  "homepage": "https://claude-adapter.pages.dev/",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "inquirer": "^8.2.6"
  },
  "optionalDependencies": {
    "claude-adapter-darwin-arm64": "2.0.0",
    "claude-adapter-darwin-x64": "2.0.0",
    "claude-adapter-linux-arm64-gnu": "2.0.0",
    "claude-adapter-linux-x64-gnu": "2.0.0",
    "claude-adapter-win32-x64-msvc": "2.0.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "javascript-obfuscator": "^5.4.3",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
